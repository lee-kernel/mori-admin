{
  "name": "mori-admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:preview": "vite --mode preview",
    "typecheck": "vue-tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "test": "npm run typecheck && npm run check:ui",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint --cache --max-warnings 0 \"src/**/*.{vue,js,ts,tsx}\"",
    "lint:eslint:fix": "npm run lint:eslint -- --fix",
    "lint:prettier": "prettier --check \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "format": "prettier --write \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\""
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.1",
    "prettier": "^3.7.0",
    "sass": "^1.94.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^5.4.19",
    "vue-tsc": "^3.1.4"
  }
}
